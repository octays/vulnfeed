/target

# By Default, Ignore any .*, except .gitignore
.*
!.gitignore
!.gitattributes
!.rustfmt.toml
!.github
!.pre-commit-config.yaml
!.gitkeep



# -- Rust
# For .cargo/config.toml
!.cargo/
target/


# -- Safety net
dist/
__pycache__/
node_modules/
npm-debug.log
report.*.json

*.parquet
*.map
*.zip
*.gz
*.tar
*.tgz

# logs
logs/

# -- SQLite
*.db
*.db-wal
*.db-shm

# -- Frontend build output
assets/public/

# -- Staged frontend assets (embedded at build time by build.rs)
public/*
!public/.gitkeep
